{
  "name": "lightray-research-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/serve.mjs --watch",
    "preview": "node scripts/serve.mjs",
    "lint": "eslint .",
    "test": "node --test tests/content.test.mjs",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run build && npm test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "cheerio": "^1.2.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0"
  }
}
